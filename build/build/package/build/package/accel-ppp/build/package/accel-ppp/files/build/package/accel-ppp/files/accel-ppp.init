#!/bin/sh /etc/rc.common
# accel-ppp PPPoE 服务端
START=80
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/accel-ppp ] || return 0
	[ -f /etc/accel-ppp.conf ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/accel-ppp -c /etc/accel-ppp.conf -p /var/run/accel-ppp.pid
	procd_set_param respawn 3600 5 0
	procd_set_param file /etc/accel-ppp.conf
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
