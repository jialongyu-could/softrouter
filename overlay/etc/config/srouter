# SoftRouter 核心配置（面板读写本文件，再由 sr.sh 生成 OpenWrt 原生配置）
# 不要手工修改运行中的 network/dhcp/mwan3/accel-ppp，统一改这里后执行 srouter apply

config settings 'settings'
	option hostname 'SoftRouter'
	option dns1 '223.5.5.5'
	option dns2 '119.29.29.29'
	option ping4 '223.5.5.5'
	option ping6 '2400:3200::1'
	option monitor_interval '5'
	option dmz_enable '0'
	option dmz_ip ''
	option sqm_enable '0'
	option sqm_iface 'br-lan'
	option sqm_dl '0'
	option sqm_ul '0'
	option qdisc 'cake'

config lan 'lan'
	option ip '192.168.100.1'
	option mask '255.255.255.0'
	option ports 'eth0'
	option dhcp_enable '1'
	option dhcp_start '192.168.100.10'
	option dhcp_end '192.168.100.250'
	option dhcp_lease '12h'
	option ip6assign '60'

# 本机 PPPoE 服务端（accel-ppp）：下游设备从 device/vlan 对应入口拨号
config pppoe 'pppoe'
	option enabled '0'
	option engine 'accel-ppp'
	option device 'br-lan'
	option vlan '0'
	option ac_name 'SoftRouter'
	option service_name 'sparrow'
	option localip '192.168.200.1'
	option netmask '255.255.255.0'
	option pool_start '192.168.200.100'
	option pool_end '192.168.200.200'
	option maxsessions '200'
	option dns1 '223.5.5.5'
	option dns2 '119.29.29.29'
	option mtu '1492'
	option lcp_interval '20'
	option lcp_failure '3'
	option v6 '1'
	option v6_link ''
	option v6_prefix ''
	option v6_prefix_len '64'
	option v6_pool_len '56'

# 麻雀云 trea 调度客户端（二进制由麻雀云提供，放置 /usr/bin/trea）
config trea 'trea'
	option enabled '0'
	option server ''
	option token ''
	option iface ''
	option interval '60'
	option extra ''
