#!/bin/sh /etc/rc.common
# 麻雀云 trea 调度客户端
START=95
STOP=01
USE_PROCD=1

start_service() {
	[ -x /usr/bin/trea ] || return 0
	[ -f /etc/trea.conf ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/trea -c /etc/trea.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/trea.conf
	procd_close_instance
}
