#!/bin/sh /etc/rc.common
# SoftRouter 监控守护进程
START=90
STOP=10
USE_PROCD=1

start_service() {
	# 首启按 /etc/config/srouter 生成一次原生配置（/tmp 每次重启清空）
	if [ ! -f /tmp/sr_boot_applied ]; then
		( sleep 8; /usr/lib/srouter/sr.sh apply >/dev/null 2>&1; touch /tmp/sr_boot_applied ) &
	fi

	procd_open_instance
	procd_set_param command /usr/lib/srouter/monitor.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}
