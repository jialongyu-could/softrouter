#!/bin/sh /etc/rc.common
# LongOS 远程 Agent 守护（HTTPS 控制通道 + WireGuard / frp 可选通道）
# Agent 自身是纯出站连接，设备位于 NAT 后、无公网 IP 也能被远程管理

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get longos-agent.agent.enabled)" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/longos-agent run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param limits core="0"
	procd_close_instance
}
