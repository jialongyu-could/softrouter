#!/bin/sh
# 首启初始化：升级迁移、主机名、时区、默认密码、启动监控

# ---- 从旧版（srouter）升级迁移 ----
# sysupgrade 保留 /etc：配置文件名变了，不迁移会回到默认值
# uci-defaults 按文件名顺序执行，先删掉旧脚本，避免它把主机名改回 SoftRouter
rm -f /etc/uci-defaults/90-softrouter
[ -f /etc/config/srouter ] && mv -f /etc/config/srouter /etc/config/longos
[ -f /etc/sr-defaults ] && mv -f /etc/sr-defaults /etc/lo-defaults
rm -rf /etc/srouter /etc/sr-version

# 旧 init 脚本与 rc.d 软链会随 /etc 保留，不清理会再起一个指向已删除路径的守护进程
if [ -f /etc/init.d/srouter ]; then
	/etc/init.d/srouter stop 2>/dev/null
	/etc/init.d/srouter disable 2>/dev/null
	rm -f /etc/init.d/srouter /etc/rc.d/S90srouter /etc/rc.d/K10srouter
fi

# 防火墙里旧的 sr_* 段不会被 gen_firewall 清理（它只删 lo_*）
for s in $(uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.\(sr_[^.=]*\)=.*/\1/p"); do
	uci -q delete "firewall.$s"
done
uci -q commit firewall 2>/dev/null

[ -f /etc/config/longos ] || touch /etc/config/longos

PW="admin"
[ -f /etc/lo-defaults ] && PW=$(cat /etc/lo-defaults)
[ -n "$PW" ] && {
	echo "root:$PW" | chpasswd 2>/dev/null || \
		printf '%s\n%s\n' "$PW" "$PW" | passwd root >/dev/null 2>&1
}

uci -q set system.@system[0].hostname='LongOS'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q commit system

# ---- 默认管理员账号 longos / longos ----
# uid 0：面板 rpcd 的 file.exec ACL 按 root 放行，普通用户会缺少写权限
# 首次登录必须改密：标记文件存在期间，lo.sh 只放行密码相关命令
LO_PWFLAG=/etc/longos/pwchange
mkdir -p /etc/longos
if ! grep -q '^longos:' /etc/passwd; then
	echo 'longos:x:0:0:LongOS Admin:/root:/bin/ash' >> /etc/passwd
	echo 'longos:!:0:0:99999:7:::' >> /etc/shadow
	printf 'longos:longos\n' | chpasswd 2>/dev/null || \
		printf 'longos\nlongos\n' | passwd longos >/dev/null 2>&1
	printf 'longos\n' > "$LO_PWFLAG"
elif [ -f "$LO_PWFLAG" ]; then
	# 账号存在且仍处于初始状态（从未改密）：保持默认密码可用，升级不打断首登流程
	printf 'longos:longos\n' | chpasswd 2>/dev/null || \
		printf 'longos\nlongos\n' | passwd longos >/dev/null 2>&1
fi
chmod 600 "$LO_PWFLAG" 2>/dev/null

chmod 755 /usr/lib/longos/lo.sh /usr/lib/longos/monitor.sh /usr/lib/longos/lo-auth.sh \
	/usr/sbin/longos /usr/sbin/longos-agent \
	/www/cgi-bin/longos-auth /www/cgi-bin/longos-reg \
	/etc/accel-ppp/ip-up.sh /etc/accel-ppp/ip-down.sh 2>/dev/null
chmod 600 /etc/config/longos-agent 2>/dev/null

[ -f /etc/config/longos-agent ] || printf "config agent 'agent'\n\toption enabled '1'\n\toption server 'https://www.yjlxxcc.top'\n\toption interval '15'\n" > /etc/config/longos-agent

/etc/init.d/longos enable 2>/dev/null
/etc/init.d/longos restart 2>/dev/null
/etc/init.d/longos-agent enable 2>/dev/null
/etc/init.d/longos-agent restart 2>/dev/null

rm -f /etc/uci-defaults/90-longos
exit 0
