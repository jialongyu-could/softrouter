{#
 LongOS 登录页（对照爱快 4.0 登录页还原：浅蓝流动背景 + 半透明毛玻璃卡片 + 协议勾选）
 覆盖 luci-theme-bootstrap 自带的 sysauth.ut：
   - 认证仍由 dispatcher 处理，POST 字段固定为 luci_username / luci_password
   - fuser 非空表示上一次登录失败
-#}

{%
	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>登录 - LongOS</title>
<style>
	* { box-sizing: border-box; }
	html, body { height: 100%; margin: 0; }
	body {
		font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
		background: linear-gradient(135deg, #eef5fc 0%, #f6fafe 45%, #e9f2fb 100%);
		color: #333;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		position: relative;
	}
	/* 背景流动光带 */
	body::before, body::after {
		content: "";
		position: fixed;
		border-radius: 50%;
		filter: blur(60px);
		pointer-events: none;
	}
	body::before {
		width: 720px; height: 720px; left: -260px; top: -320px;
		background: radial-gradient(circle, rgba(255,255,255,.95) 0%, rgba(214,232,250,.55) 55%, rgba(214,232,250,0) 100%);
	}
	body::after {
		width: 820px; height: 820px; right: -300px; bottom: -380px;
		background: radial-gradient(circle, rgba(255,255,255,.9) 0%, rgba(203,224,247,.5) 55%, rgba(203,224,247,0) 100%);
	}
	.card {
		position: relative;
		z-index: 1;
		width: 400px;
		max-width: calc(100vw - 32px);
		padding: 32px 30px 26px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.62);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
		animation: cardin .4s ease-out both;
	}
	@keyframes cardin {
		from { opacity: 0; transform: translateY(14px); }
		to   { opacity: 1; transform: none; }
	}
	.logo {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		margin-bottom: 30px;
	}
	.logo .mark {
		width: 34px; height: 34px;
		border-radius: 9px;
		background: linear-gradient(135deg, #1677ff, #4c9dff);
		color: #fff;
		font-size: 19px;
		font-weight: 700;
		line-height: 34px;
		text-align: center;
	}
	.logo .word {
		font-size: 27px;
		font-weight: 800;
		letter-spacing: 0.5px;
		color: #1677ff;
	}
	.err {
		margin: -14px 0 14px;
		padding: 8px 12px;
		border-radius: 6px;
		font-size: 12px;
		color: #d4380d;
		background: #fff2e8;
		border: 1px solid #ffd8bf;
	}
	.field {
		position: relative;
		margin-bottom: 14px;
	}
	.field svg {
		position: absolute;
		left: 12px; top: 50%;
		width: 16px; height: 16px;
		transform: translateY(-50%);
		fill: #b6c0cd;
	}
	.field input {
		width: 100%;
		height: 40px;
		padding: 0 40px 0 36px;
		border: 1px solid #e3e9f2;
		border-radius: 6px;
		background: #fff;
		font-size: 14px;
		color: #333;
		outline: 0;
		transition: border-color .15s, box-shadow .15s;
	}
	.field input::placeholder { color: #b9c2cf; }
	.field input:focus {
		border-color: #1677ff;
		box-shadow: 0 0 0 2px rgba(22, 119, 255, .12);
	}
	.eye {
		position: absolute;
		right: 8px; top: 50%;
		transform: translateY(-50%);
		width: 26px; height: 26px;
		border: 0;
		background: transparent;
		cursor: pointer;
		padding: 0;
	}
	.eye svg { position: static; transform: none; width: 17px; height: 17px; fill: #b6c0cd; }
	.eye:hover svg { fill: #1677ff; }
	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 2px 0 16px;
		font-size: 12px;
		color: #8d97a6;
	}
	.chk {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		cursor: pointer;
		user-select: none;
	}
	.chk input {
		width: 13px; height: 13px;
		margin: 0;
		accent-color: #1677ff;
		cursor: pointer;
	}
	.hint {
		position: relative;
		color: #8d97a6;
		cursor: help;
	}
	.hint:hover::after {
		content: "请在路由器 VGA 接口连接显示器、USB 接口连接键盘，进入控制台重置密码";
		position: absolute;
		right: 0; bottom: 22px;
		width: 236px;
		padding: 8px 10px;
		border: 1px solid #e6ebf2;
		border-radius: 6px;
		background: #fff;
		box-shadow: 0 4px 14px rgba(0,0,0,.08);
		font-size: 12px;
		line-height: 1.6;
		color: #5b6675;
		z-index: 9;
	}
	.btn {
		width: 100%;
		height: 40px;
		border: 0;
		border-radius: 6px;
		background: #1677ff;
		color: #fff;
		font-size: 15px;
		letter-spacing: 2px;
		cursor: pointer;
		transition: background .15s, box-shadow .15s;
	}
	.btn:hover { background: #0f66e0; box-shadow: 0 4px 14px rgba(22,119,255,.3); }
	.btn:active { transform: translateY(1px); }
	.agree {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-top: 14px;
		font-size: 12px;
		color: #8d97a6;
	}
	.agree a { color: #1677ff; text-decoration: none; }
	.agree a:hover { text-decoration: underline; }
	.tip {
		margin: 12px 0 0;
		font-size: 11px;
		line-height: 1.6;
		color: #a9b3c1;
		text-align: center;
	}
</style>
</head>
<body>
	<form class="card" method="post" autocomplete="on" id="loginForm">
		<div class="logo">
			<span class="mark">L</span>
			<span class="word">LongOS</span>
		</div>

		{% if (fuser != null && fuser != ''): %}
		<div class="err">用户名或密码错误，请重新输入</div>
		{% endif %}

		<div class="field">
			<svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"/></svg>
			<input name="luci_username" id="luci_username" type="text"
				placeholder="请输入用户名" value="{{ entityencode(duser, true) }}"
				autocomplete="username" autofocus>
		</div>

		<div class="field">
			<svg viewBox="0 0 24 24"><path d="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9h-2zM9 7a3 3 0 0 1 6 0v2H9V7zm3 11a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>
			<input name="luci_password" id="luci_password" type="password"
				placeholder="请输入密码" autocomplete="current-password">
			<button type="button" class="eye" id="eyeBtn" aria-label="显示密码">
				<svg viewBox="0 0 24 24"><path d="M12 5c-5 0-9.3 3.1-11 7 1.7 3.9 6 7 11 7s9.3-3.1 11-7c-1.7-3.9-6-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
			</button>
		</div>

		<div class="row">
			<label class="chk"><input type="checkbox" id="remember">记住密码</label>
			<span class="hint">忘记密码?</span>
		</div>

		<button type="submit" class="btn" id="submitBtn">登 录</button>

		<label class="agree">
			<input type="checkbox" id="agreed">
			我已阅读并同意 <a href="#" onclick="return false">用户协议</a> 与 <a href="#" onclick="return false">数据处理协议</a>
		</label>

		<p class="tip" id="tip"></p>
	</form>

	<script>
	(function() {
		var KEY = 'longos_login_name';
		var u = document.getElementById('luci_username');
		var p = document.getElementById('luci_password');
		var rm = document.getElementById('remember');
		var agree = document.getElementById('agreed');
		var tip = document.getElementById('tip');

		// 记住密码：仅记住用户名（浏览器不允许预填密码）
		try {
			var saved = localStorage.getItem(KEY);
			if (saved) { u.value = saved; rm.checked = true; p.focus(); }
		} catch (e) {}

		// 密码可见切换
		document.getElementById('eyeBtn').onclick = function() {
			p.type = p.type === 'password' ? 'text' : 'password';
		};

		// 协议未勾选时提示，不阻塞提交以避免误锁
		document.getElementById('loginForm').onsubmit = function() {
			if (!agree.checked) {
				tip.textContent = '请先阅读并勾选同意用户协议与数据处理协议';
				tip.style.color = '#d4380d';
				return false;
			}
			try {
				if (rm.checked) localStorage.setItem(KEY, u.value);
				else localStorage.removeItem(KEY);
			} catch (e) {}
			return true;
		};

		agree.onchange = function() {
			if (agree.checked) { tip.textContent = ''; }
		};
	})();
	</script>
</body>
</html>
