 LongOS 覆盖 LuCI 通用 header：在会话建立后的每个管理页面注入“默认密码强制修改”检查。
 命中时跳转 /longos/pwchange.html（公开改密页，凭旧密码修改），与 lo.sh 的后端锁定共同生效。
-#}

{%
	include(`themes/${theme}/header`);
-%}

<script src="{{ resource }}/luci.js?v={# PKG_VERSION #}-{{ pkgs_update_time }}"></script>
<script>
	L = new LuCI({{ replace(`${ {
		media          : media,
		resource       : resource,
		scriptname     : http.getenv("SCRIPT_NAME"),
		pathinfo       : http.getenv("PATH_INFO"),
		documentroot   : http.getenv("DOCUMENT_ROOT"),
		requestpath    : ctx.request_path,
		dispatchpath   : ctx.path,
		pollinterval   : +config.main.pollinterval || 5,
		ubuspath       : config.main.ubuspath || '/ubus/',
		sessionid      : ctx.authsession,
		token          : ctx.authtoken,
		nodespec       : dispatched,
		apply_rollback : max(+config.apply.rollback ||  90, 90),
		apply_holdoff  : max(+config.apply.holdoff  ||   4,  1),
		apply_timeout  : max(+config.apply.timeout  ||   5,  1),
		apply_display  : max(+config.apply.display  || 1.5,  1),
		rollback_token : rollback_token
	} }`, '/', '\\/') }});
</script>
<script>
	/* LongOS：默认密码未修改时，任何已登录页面都强制跳转到改密页 */
	(function() {
		if (location.pathname.indexOf('/longos/pwchange') === 0)
			return;

		var xhr = new XMLHttpRequest();
		xhr.open('GET', '/cgi-bin/longos-auth?action=state&_=' + Date.now(), true);
		xhr.timeout = 4000;
		xhr.onload = function() {
			var s = null;
			try { s = JSON.parse(xhr.responseText || '{}'); } catch (e) {}
			if (s && s.must_change)
				location.replace('/longos/pwchange.html?from=' + encodeURIComponent(location.pathname));
		};
		xhr.send();
	})();
</script>
